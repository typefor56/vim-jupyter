{
  "name": "vim-notebook",
  "displayName": "Vim Notebook",
  "description": "Vim where VSCodeVim stops short in Jupyter notebooks: gd/Ctrl-O jumps across cells, and your Vim keys (:w, :q, Ctrl-W, leader mappings) on a selected cell.",
  "version": "0.12.2",
  "publisher": "for56",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vimNotebook.goToDefinition",
        "title": "Go to Definition (remember position)",
        "category": "Vim Notebook"
      },
      {
        "command": "vimNotebook.back",
        "title": "Jump Back",
        "category": "Vim Notebook"
      },
      {
        "command": "vimNotebook.forward",
        "title": "Jump Forward",
        "category": "Vim Notebook"
      },
      {
        "command": "vimNotebook.ex",
        "title": "Vim Command Line (:) on the Selected Cell",
        "category": "Vim Notebook"
      },
      {
        "command": "vimNotebook.search",
        "title": "Search the Notebook (//)",
        "category": "Vim Notebook"
      },
      {
        "command": "vimNotebook.searchNext",
        "title": "Next Match (n)",
        "category": "Vim Notebook"
      },
      {
        "command": "vimNotebook.searchPrevious",
        "title": "Previous Match (N)",
        "category": "Vim Notebook"
      },
      {
        "command": "vimNotebook.noHighlight",
        "title": "Clear Search Highlight (:noh)",
        "category": "Vim Notebook"
      },
      {
        "command": "vimNotebook.quitEdit",
        "title": "Leave the Cell",
        "category": "Vim Notebook"
      },
      {
        "command": "vimNotebook.enterCell",
        "title": "Enter the Cell",
        "category": "Vim Notebook"
      }
    ],
    "keybindings": [
      {
        "key": ",",
        "command": "vimNotebook.key",
        "args": ",",
        "when": "notebookEditorFocused && !inputFocus && !vimNotebook.cmdline"
      },
