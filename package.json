    "configuration": {
      "title": "Vim Notebook",
      "properties": {
        "vimNotebook.commandLine": {
          "type": "string",
          "enum": [
            "visibleCell",
            "statusBar"
          ],
          "default": "statusBar",
          "enumDescriptions": [
            "':' enters a code cell already on screen (the real Vim command line); with none visible, the status-bar command line.",
            "':' always opens a command line imitated in the status bar: nothing on screen moves; w, q, wq, x, q!, wa, qa, wqa."
          ],
          "description": "Where ':' on a selected cell (outside edit mode) opens the command line."
        },
        "vimNotebook.keyboardLayout": {
          "type": "string",
          "enum": [
            "qwerty",
            "azerty"
          ],
          "default": "qwerty",
          "enumDescriptions": [
            "US / QWERTY keyboard.",
            "French AZERTY keyboard (as read with \"keyboard.dispatch\": \"keyCode\": a key is seen as its shifted character, so '_' arrives as '8')."
          ],
          "description": "Keyboard layout, for the characters typed on the status-bar ':' and '//' lines."
        }
      }
    },
    "notebookRenderer": [
      {
        "id": "vim-notebook.markdown-search",
        "displayName": "Vim Notebook search highlight in markdown",
        "entrypoint": {
          "extends": "vscode.markdown-it-renderer",
          "path": "./renderer.js"
        },
        "requiresMessaging": "optional"
      }
    ]
